rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // STUDENTS COLLECTION
    // ==========================================
    match /students/{studentId} {
      allow read: if request.auth != null
        && (request.auth.token.role in ['super_admin', 'kesantrian', 'bendahara']
        || (request.auth.token.role == 'wali_santri'
            && request.auth.token.studentId == studentId));

      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];

      // Sub-collection: Grades
      match /grades/{gradeId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.token.role in ['super_admin'];
      }

      // Sub-collection: Violations
      match /violations/{violationId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.token.role in ['super_admin', 'kesantrian'];
      }
    }

    // ==========================================
    // INVOICES COLLECTION
    // ==========================================
    match /invoices/{invoiceId} {
      allow read: if request.auth != null
        && (request.auth.token.role in ['super_admin', 'bendahara']
        || (request.auth.token.role == 'wali_santri'
            && request.auth.token.studentId == resource.data.studentId));

      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];

      allow delete: if request.auth != null
        && request.auth.token.role == 'super_admin';
    }

    // ==========================================
    // PAYMENTS COLLECTION
    // ==========================================
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (request.auth.token.role in ['super_admin', 'bendahara']
        || request.auth.token.role == 'wali_santri');

      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];
    }

    // ==========================================
    // ATTENDANCE COLLECTION
    // ==========================================
    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // CURRICULUM COLLECTION
    // ==========================================
    match /curriculum/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // ACTIVITY LOGS
    // ==========================================
    match /activity_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // CLASSES COLLECTION
    // ==========================================
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // DORMITORIES COLLECTION
    // ==========================================
    match /dormitories/{dormitoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // ACADEMIC YEARS COLLECTION
    // ==========================================
    match /academic_years/{yearId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // PERIODS COLLECTION
    // ==========================================
    match /periods/{periodId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // PRAYER ATTENDANCE COLLECTION
    // ==========================================
    match /prayer_attendance/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // FASTING TRACKING COLLECTION
    // ==========================================
    match /fasting_tracking/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // TAHAJJUD TRACKING COLLECTION
    // ==========================================
    match /tahajjud_tracking/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // DAILY WIRID COLLECTION
    // ==========================================
    match /daily_wirid/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // DAILY INFAQ COLLECTION
    // ==========================================
    match /daily_infaq/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ZAKAT COLLECTION
    // ==========================================
    match /zakat/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // MEDICAL RECORDS COLLECTION
    // ==========================================
    match /medical_records/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // GROWTH MONITORING COLLECTION
    // ==========================================
    match /growth_monitoring/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // SANITATION COLLECTION
    // ==========================================
    match /sanitation/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // NUTRITION COLLECTION
    // ==========================================
    match /nutrition/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // TEACHERS COLLECTION
    // ==========================================
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // ALUMNI COLLECTION
    // ==========================================
    match /alumni/{alumniId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ALUMNI EVENTS COLLECTION
    // ==========================================
    match /alumni_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // GRADUATIONS COLLECTION
    // ==========================================
    match /graduations/{gradId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // REGISTRATIONS (PSB) COLLECTION
    // ==========================================
    match /registrations/{regId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
      allow create: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ADMISSIONS TESTS COLLECTION
    // ==========================================
    match /admissions_tests/{testId} {
      allow read, write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ADMISSIONS RESULTS COLLECTION
    // ==========================================
    match /admissions_results/{resultId} {
      allow read, write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // SCHEDULES COLLECTION
    // ==========================================
    match /schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // PERMITS COLLECTION
    // ==========================================
    match /permits/{permitId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // REWARDS COLLECTION
    // ==========================================
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ANNOUNCEMENTS COLLECTION
    // ==========================================
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // COOPERATIVES COLLECTION
    // ==========================================
    match /cooperatives/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];
    }

    // ==========================================
    // INVENTORY COLLECTION
    // ==========================================
    match /inventory/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // KHIDMAH COLLECTION
    // ==========================================
    match /khidmah/{khidmahId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // HADROH COLLECTION
    // ==========================================
    match /hadroh/{hadrohId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // EXTRACURRICULAR COLLECTION
    // ==========================================
    match /extracurricular/{extId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // PUBLIC SPEAKING COLLECTION
    // ==========================================
    match /public_speaking/{speechId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // MEDIA COLLECTION
    // ==========================================
    match /media/{mediaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // ARTS COLLECTION
    // ==========================================
    match /arts/{artId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'kesantrian'];
    }

    // ==========================================
    // SPP CONFIG COLLECTION
    // ==========================================
    match /spp_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];
    }

    // ==========================================
    // SCHOLARSHIPS COLLECTION
    // ==========================================
    match /scholarships/{scholarshipId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];
    }

    // ==========================================
    // SALARIES COLLECTION
    // ==========================================
    match /salaries/{salaryId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['super_admin', 'bendahara'];
      allow write: if request.auth != null
        && request.auth.token.role in ['super_admin'];
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
